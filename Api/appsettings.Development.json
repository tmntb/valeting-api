{
  "ConnectionStrings": {
    "ValetingConnection": "Server=localhost,1433;Database=Valeting;User ID=sa;Password={SA_PASSWORD};Integrated Security=False;Trusted_Connection=False;TrustServerCertificate=True;",
    "RedisConnection": "{REDIS_CONNECTION}"
  },
  "Jwt": {
    "Key": "{JWT_KEY}",
    "Issuer": "ValetingAuth",
    "Audience": "ValetingClient"
  },
  "WebAuthn": {
    "RpId": "{PK_RPID}",
    "RpName": "{PK_RPNAME}",
    "Origins": "{PK_ORIGINS}"
  },
  "RateLimiting": "{RATE_LIMITING}",
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
